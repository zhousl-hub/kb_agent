# MySQL Configuration
MYSQL_ROOT_PASSWORD=root123456
MYSQL_USER=tykbs
MYSQL_PASSWORD=tykbs123456

# Redis Configuration
REDIS_PASSWORD=redis123456

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Keycloak Configuration
KC_DB_USERNAME=root
KC_DB_PASSWORD=root123456
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123456

# Keycloak Client Secrets (generate your own in production)
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Dify Integration
# 容器网络内默认通过别名 dify-api 访问 Dify API（见 code/dify/docker/docker-compose.kba.yml）
DIFY_API_URL=http://dify-api:5001
# 在 Dify 控制台创建应用后生成 API Key，填入此处（未配置时对话/检索调用会失败）
DIFY_API_KEY=